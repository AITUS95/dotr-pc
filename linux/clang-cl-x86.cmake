# Cross-compile 32-bit Windows from Linux: clang-cl + lld-link + xwin's SDK/CRT.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR X86)
set(XWIN "$ENV{HOME}/decomp/xwin")
set(CMAKE_C_COMPILER /usr/lib/llvm-21/bin/clang-cl)
set(CMAKE_LINKER /usr/lib/llvm-21/bin/lld-link)
set(CMAKE_RC_COMPILER /usr/lib/llvm-21/bin/llvm-rc)
set(CMAKE_AR /usr/lib/llvm-21/bin/llvm-lib)
set(CMAKE_C_COMPILER_TARGET i686-pc-windows-msvc)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(INC "/imsvc ${XWIN}/crt/include /imsvc ${XWIN}/sdk/include/ucrt /imsvc ${XWIN}/sdk/include/um /imsvc ${XWIN}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "--target=i686-pc-windows-msvc -m32 ${INC}")
set(LIBS "/libpath:${XWIN}/crt/lib/x86 /libpath:${XWIN}/sdk/lib/ucrt/x86 /libpath:${XWIN}/sdk/lib/um/x86")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${LIBS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${LIBS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${LIBS}")
